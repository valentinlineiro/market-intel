# ── LLM providers (prioridad: Groq → OpenRouter → Anthropic) ─────────────
# Groq — gratis, rápido: console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant          # opcional, este es el default

# OpenRouter — gratis con modelos :free: openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free  # opcional

# Anthropic — de pago, fallback: console.anthropic.com
ANTHROPIC_API_KEY=

# ── Reddit ────────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=market-intel/0.1 by tu_usuario_reddit

# ── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Cloudflare Pages ──────────────────────────────────────────────────────
CF_PAGES_PROJECT=market-intel
CF_PAGES_DOMAIN=market-intel.pages.dev

# URL Worker externo para /signup. Vacío = usa Pages Function (recomendado).
CF_SIGNUP_WORKER_URL=
