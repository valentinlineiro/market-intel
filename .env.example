# ── Reddit ────────────────────────────────────────────────────────────────
# Crea una app en https://www.reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=market-intel/0.1 by tu_usuario_reddit

