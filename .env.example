# ── LLM providers ────────────────────────────────────────────────────────
GROQ_API_KEY=                               # gratis: console.groq.com
OPENROUTER_API_KEY=                         # gratis: openrouter.ai
ANTHROPIC_API_KEY=                          # fallback de pago

# ── Worker API (backend de datos en producción) ───────────────────────────
WORKER_URL=https://market-intel-api.valentinlineiro.workers.dev
WORKER_SECRET=                              # openssl rand -hex 32

# ── Reddit ────────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=market-intel/0.1 by valentinlineiro

# ── Telegram ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Cloudflare Pages deploy ───────────────────────────────────────────────
CF_PAGES_PROJECT=market-intel
CF_PAGES_DOMAIN=market-intel-36d.pages.dev
CLOUDFLARE_API_TOKEN=                       # permiso: Pages + D1 + Workers
CLOUDFLARE_ACCOUNT_ID=

# ── Solo si usas D1 REST directamente (sin Worker) ────────────────────────
# CF_D1_DATABASE_ID=
