#!/usr/bin/env bash
# ARCH commit-msg hook — POSIX compatible

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Exemptions — idea:, sprint management, THINK sessions
if echo "$COMMIT_MSG" | grep -qE '^(idea:|chore: (open|close) sprint/|.*\[THINK\])'; then
    exit 0
fi

# Check if TASK-ID already present
if echo "$COMMIT_MSG" | grep -qE '\[TASK-[0-9]+\]'; then
    exit 0
fi

# Try to extract TASK-ID from branch name
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if echo "$BRANCH_NAME" | grep -qiE 'task-[0-9]+'; then
    TASK_ID=$(echo "$BRANCH_NAME" | grep -ioE 'task-[0-9]+' | head -1 | tr '[:lower:]' '[:upper:]')
    echo "[$TASK_ID] $COMMIT_MSG" > "$COMMIT_MSG_FILE"
    exit 0
fi

# Warn but don't block — brownfield transition period
echo "Warning: No TASK-ID found in commit message. Add [TASK-XXX] when possible."
exit 0
